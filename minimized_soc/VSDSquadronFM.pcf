# =============================================================================
# Physical Constraints File (.pcf) for VSDSquadron FM (Lattice iCE40UP5K-SG48)
# Matched exactly to vsd_FPGA/hello and gaurav_demo/uart
# =============================================================================

# Hardware Clock Pin (Mapped to Pin 20; internal SB_HFOSC is used inside RTL)
set_io  hw_clk        20

# FTDI FT232H USB-UART Serial Interface
set_io  uart_tx_pin   14
set_io  uart_rx_pin   15

# On-board RGB LED (Driven by SB_RGBA_DRV hard macro)
set_io  led_green     40
set_io  led_red       39
set_io  led_blue      41
